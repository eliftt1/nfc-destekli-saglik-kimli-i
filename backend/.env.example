# Kopyalayın: cp .env.example .env  — sonra değerleri doldurun. Bu dosyaya gerçek sır yazmayın.
NODE_ENV=development
PORT=4000

# MySQL/MariaDB bağlantısı (XAMPP'te parolasız root)
DATABASE_URL="mysql://root@localhost:3307/nfc_health"
# Testler bu veritabanını KULLANIR ve içeriğini siler. Geliştirme veritabanından FARKLI olmalı.
DATABASE_URL_TEST="mysql://root@localhost:3307/nfc_health_test"

# Etiket/QR bağlantılarının üretileceği herkese açık adres. Üretimde https:// olmalı.
APP_BASE_URL=http://localhost:5173

# Gizli değerler: aşağıdaki komutlarla üretin ve burada yer tutucuyu değiştirin.
HEALTH_DATA_KEY=
TOKEN_PEPPER=
CSRF_SECRET=

SESSION_TTL_DAYS=7
ACCESS_LOG_RETENTION_DAYS=30
TRUST_PROXY=0

# İsteğe bağlı SMTP. Boş bırakılırsa şifre sıfırlama bağlantısı yalnızca sunucu konsoluna yazılır.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Acil Sağlık <no-reply@example.com>"